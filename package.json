{
  "name": "rollup-plugin-copy",
  "description": "Copy files and folders using Rollup",
  "version": "3.5.0",
  "author": "Vlad Shcherbin <vlad.shcherbin@gmail.com>",
  "repository": "vladshcherbin/rollup-plugin-copy",
  "main": "dist/index.commonjs.js",
  "module": "dist/index.module.js",
  "types": "index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "lint": "eslint",
    "postpublish": "pnpm clean",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm clean && pnpm build",
    "test": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "colorette": "^2.0.20",
    "fs-extra": "^11.3.2",
    "globby": "16.0.0",
    "is-plain-object": "^5.0.0"
  },
  "devDependencies": {
    "@shcherbin/eslint-config-node": "^0.4.1",
    "eslint": "^9.39.2",
    "replace-in-file": "^5.0.2",
    "rimraf": "^6.1.0",
    "rollup": "^1.29.0",
    "tsdown": "^0.18.2"
  },
  "files": [
    "dist",
    "index.d.ts",
    "readme.md"
  ],
  "keywords": [
    "rollup",
    "rollup-plugin",
    "copy",
    "cp",
    "asset",
    "assets",
    "file",
    "files",
    "folder",
    "folders",
    "glob"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=8.3"
  },
  "type": "module",
  "license": "MIT"
}
